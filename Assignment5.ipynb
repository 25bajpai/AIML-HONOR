      "source": [
        "def adding(fun):\n",
        "  def waiting(*args,**kwargs):\n",
        "    print(\"Processing...\")\n",
        "    i = 0\n",
        "    result = fun(*args,**kwargs)\n",
        "    while i< 5:\n",
        "      print(\"-\")\n",
        "      i+= 1\n",
        "\n",
        "    return result\n",
        "\n",
        "  return waiting\n",
        "\n",
        "@adding\n",
        "def add(a,b):\n",
        "  return a+b\n",
        "\n",
        "print(\"Result : \",add('alpha','beta'))"
      ]
    }
  ]
}